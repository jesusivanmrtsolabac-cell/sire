/* =========================================================
   SIRE - TEMA OSCURO (Slate + Menta + Ámbar)
   ========================================================= */

/* Fondo global */
QWidget {
    background-color: #0f1115; /* Negro azulado muy profundo */
    color: #e2e8f0;            /* Texto gris claro */
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0f1115;
}

/* ================== SIDEBAR (MENÚ LATERAL) ================== */
QFrame#Sidebar {
    background-color: #161921; /* Un tono más claro para diferenciar */
    border-right: 1px solid #2a2e3d;
}

QLabel#Brand {
    color: #10b981; /* Verde Menta */
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 2px;
}

QLabel#BrandSubtitle {
    color: #64748b;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}

QLabel#SectionLabel {
    color: #475569;
    font-size: 11px;
    font-weight: 700;
    margin-top: 10px;
    margin-bottom: 5px;
}

/* Botones de navegación del menú */
QPushButton#NavButton {
    text-align: left;
    padding: 12px 16px;
    border-radius: 8px;
    color: #94a3b8;
    background-color: transparent;
    font-weight: 500;
    border: 1px solid transparent;
}
QPushButton#NavButton:hover {
    background-color: #1e2230;
    color: #ffffff;
}
QPushButton#NavButton:checked {
    background-color: #10b981; /* Verde Menta */
    color: #0f1115;            /* Texto oscuro para contraste */
    font-weight: 700;
}

QPushButton#ExitButton {
    text-align: left;
    padding: 10px 16px;
    border-radius: 8px;
    color: #ef4444; /* Rojo suave */
    background-color: transparent;
    font-weight: 600;
}
QPushButton#ExitButton:hover {
    background-color: rgba(239, 68, 68, 0.1);
}

QLabel#SidebarFooter {
    color: #475569;
    font-size: 11px;
    font-weight: 500;
}

/* ================== TEXTOS Y TÍTULOS ================== */
QLabel#PageTitle {
    font-size: 26px;
    font-weight: bold;
    color: #ffffff;
}
QLabel#Eyebrow {
    color: #10b981;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
}
QLabel#MutedText {
    color: #94a3b8;
    font-size: 14px;
}
QLabel#BodyText {
    color: #cbd5e1;
    font-size: 14px;
    line-height: 1.5;
}
QLabel#SmallMuted {
    color: #64748b;
    font-size: 12px;
}
QLabel#ReadyBadge {
    background-color: rgba(16, 185, 129, 0.15);
    color: #10b981;
    padding: 6px 12px;
    border-radius: 12px;
    font-weight: bold;
    font-size: 12px;
}

/* ================== PANELES Y TARJETAS ================== */
QFrame#Panel {
    background-color: #161921;
    border: 1px solid #2a2e3d;
    border-radius: 12px;
}
QLabel#PanelHeading {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 8px;
}
QLabel#PlaceholderIcon {
    font-size: 48px;
    color: #10b981;
}

/* Tarjetas del Dashboard */
QFrame#MetricCard {
    background-color: #161921;
    border: 1px solid #2a2e3d;
    border-radius: 12px;
}
QLabel#MetricNumber {
    color: #2a2e3d;
    font-size: 24px;
    font-weight: 800;
}
QLabel#MetricValue {
    color: #10b981;
    font-size: 28px;
    font-weight: bold;
}

/* ================== CONTROLES Y FORMULARIOS ================== */
QGroupBox {
    border: 1px solid #2a2e3d;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 16px;
    font-weight: bold;
    color: #e2e8f0;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #10b981; /* Color verde menta para títulos de grupo */
}

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0f1115;
    border: 1px solid #2a2e3d;
    border-radius: 6px;
    padding: 8px;
    color: #ffffff;
}
QComboBox:focus, QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #10b981;
}
QComboBox::drop-down {
    border: none;
}
QComboBox QAbstractItemView {
    background-color: #161921;
    color: #ffffff;
    selection-background-color: #10b981;
    selection-color: #0f1115;
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: #2a2e3d;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #10b981;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #34d399;
}

/* Botones de acción generales */
QPushButton#ActionButton {
    background-color: #10b981;
    color: #0f1115;
    font-weight: bold;
    border-radius: 6px;
    padding: 10px;
}
QPushButton#ActionButton:hover {
    background-color: #34d399;
}

/* ================== TABLAS ================== */
QTableWidget, QTableView {
    background-color: #161921;
    alternate-background-color: #1e2230;
    color: #e2e8f0;
    gridline-color: #2a2e3d;
    border: 1px solid #2a2e3d;
    border-radius: 8px;
}
QHeaderView::section {
    background-color: #1e2230;
    color: #10b981;
    padding: 8px;
    border: 1px solid #2a2e3d;
    font-weight: bold;
}
QTableWidget::item:selected {
    background-color: rgba(16, 185, 129, 0.2);
    color: #ffffff;
}

/* ================== SCROLLBARS ================== */
QScrollBar:vertical {
    background: #0f1115;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #2a2e3d;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #10b981;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
